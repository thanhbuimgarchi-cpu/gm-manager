{
  "name": "gm-crm-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "GM Manager desktop application",
  "main": "main.cjs",
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.mgarchi.gmcrm",
    "productName": "GM-CRM",
    "artifactName": "GM-CRM-${os}-${arch}.${ext}",
    "extraResources": [{ "from": "../public/gm-logo-512.png", "to": "gm-logo-512.png" }],
    "asar": true,
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "directories": { "output": "release" },
    "win": { "artifactName": "GM-CRM-Setup.exe", "icon": "../public/gm-logo-512.png", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "mac": { "artifactName": "GM-CRM-macOS-${arch}.${ext}", "target": [{ "target": "dmg", "arch": ["x64"] }], "category": "public.app-category.productivity" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GM-CRM"
    }
  }
}
