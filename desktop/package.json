{
  "name": "gm-crm-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "GM-CRM for Windows",
  "main": "main.cjs",
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.mgarchi.gmcrm",
    "productName": "GM-CRM",
    "artifactName": "GM-CRM-Setup.exe",
    "asar": true,
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GM-CRM"
    }
  }
}
